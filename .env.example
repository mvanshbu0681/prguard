# prguard configuration — every key from spec §4.8, with its default.
# Keys shown commented-out are unset by default.

# --- persistence ---
DATABASE_URL=postgresql+asyncpg://postgres.praereppdgwfhohzyvjb:rajma@love_3@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres

# --- auth & tenancy ---
# bearer token for mutating endpoints; unset means open (dev only)
# PRGUARD_API_TOKEN=
# requests without X-Tenant-Id resolve to this slug, seeded by migration 0001
DEFAULT_TENANT_SLUG=default

# --- LLM ---
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# one of: anthropic | gemini | fake
LLM_PROVIDER=anthropic
MODEL_SPECIALIST=claude-sonnet-5
MODEL_COORDINATOR=claude-opus-5
MODEL_PROOF_GENERATOR=claude-opus-5
MODEL_FAILBACK_CHAIN=claude-opus-5,claude-sonnet-5
LLM_TEMPERATURE=0.0
LLM_MAX_OUTPUT_TOKENS=8000
CONTEXT_TOKEN_BUDGET=120000

# --- run execution ---
REVIEW_WORKERS=2
REVIEW_MAX_CONCURRENCY=2
RUN_STALE_SECONDS=600

# --- severity (must sum to 1.0, validated at startup — spec §4.4) ---
SEVERITY_WEIGHTS={"reachability":0.20,"blast_radius":0.15,"path_sensitivity":0.25,"coverage_gap":0.15,"churn":0.10,"proof_confidence":0.15}
# band thresholds, >= semantics, must be strictly descending (spec §4.4 [ASSUMED])
SEVERITY_BANDS={"critical":0.75,"high":0.55,"medium":0.35,"low":0.15}
BLOCK_MIN_SEVERITY=high

# --- proof (spec §4.6) ---
PROOF_MIN_SCORE=0.35
PROOF_MAX_PER_RUN=3
PROOF_TIMEOUT=90
DEP_INSTALL_TIMEOUT=180
PROOF_OUTPUT_MAX_BYTES=20000
PROOF_REQUIRE_BASELINE=true
PROOF_ALLOW_SUBPROCESS=true

# --- context budget (spec §4.1 S2, E5/E6) ---
MAX_FILES=300
MAX_DIFF_BYTES=2000000

# --- GitHub ---
# GITHUB_TOKEN=
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY=
# GITHUB_WEBHOOK_SECRET=
ALLOW_UNSIGNED_WEBHOOKS=false
GITHUB_DELIVERY_MODE=auto
GITHUB_API_BASE=https://api.github.com
REVIEW_DRAFT_PRS=false
NEAREST_LINE_MAX_DISTANCE=10
GATE_CONTEXT_NAME=prguard/merge-gate
