# prguard configuration — every key from spec §4.8, with its default.
# Keys shown commented-out are unset by default.

# --- persistence ---
DATABASE_URL=sqlite+aiosqlite:///./prguard.db

# --- auth ---
# bearer token for mutating endpoints; unset means open (dev only)
# PRGUARD_API_TOKEN=

# --- LLM ---
# ANTHROPIC_API_KEY=
LLM_PROVIDER=anthropic
MODEL_SPECIALIST=claude-sonnet-5
MODEL_COORDINATOR=claude-opus-5
MODEL_PROOF_GENERATOR=claude-opus-5
MODEL_FAILBACK_CHAIN=claude-opus-5,claude-sonnet-5
LLM_TEMPERATURE=0.0
LLM_MAX_OUTPUT_TOKENS=8000
CONTEXT_TOKEN_BUDGET=120000

# --- run execution ---
REVIEW_WORKERS=2
REVIEW_MAX_CONCURRENCY=2
RUN_STALE_SECONDS=600

# --- severity (must sum to 1.0, validated at startup — spec §4.4) ---
SEVERITY_WEIGHTS={"reachability":0.20,"blast_radius":0.15,"path_sensitivity":0.25,"coverage_gap":0.15,"churn":0.10,"proof_confidence":0.15}
BLOCK_MIN_SEVERITY=high

# --- proof ---
PROOF_MIN_SCORE=0.35
PROOF_MAX_PER_RUN=3
PROOF_TIMEOUT=90
PROOF_REQUIRE_BASELINE=true
PROOF_ALLOW_SUBPROCESS=true

# --- GitHub ---
# GITHUB_TOKEN=
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY=
# GITHUB_WEBHOOK_SECRET=
ALLOW_UNSIGNED_WEBHOOKS=false
GITHUB_DELIVERY_MODE=auto
