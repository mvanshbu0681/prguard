# GitHub App (github.com/settings/apps -> your app)
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
# The private key: a file path, or the PEM itself (newlines as \n)
GITHUB_PRIVATE_KEY_PATH=./github-app.pem
GITHUB_PRIVATE_KEY=

# Local development: forward webhooks from a smee.io channel
WEBHOOK_PROXY_URL=

# Models: provider:model, providers are groq and google
GROQ_API_KEY=
GEMINI_API_KEY=
MODEL_FAST=groq:openai/gpt-oss-20b
MODEL_SMART=groq:openai/gpt-oss-120b

# Supply-chain check: Socket API key (socket.dev). Without it the check is skipped.
SOCKET_DEV_API_KEY=

# Where the dashboard runs (links in GitHub comments and sign-in redirects)
DASHBOARD_URL=http://localhost:3001

# Optional
PORT=8000
ROLE=all
DATA_DIR=data
WORKER_CONCURRENCY=4
LLM_CONCURRENCY=6
CHUNK_TOKENS=12000
MAX_CHUNKS=8
REVIEW_TOKEN_BUDGET=400000
# Reviews running at once (others wait in the queue) and tokens per minute per model
REVIEW_CONCURRENCY=2
LLM_TOKENS_PER_MINUTE=200000
# Badge images in GitHub comments; empty posts text labels instead
ASSET_BASE_URL=https://cdn.jsdelivr.net/gh/prguard-sandbox/prguard-assets@v1/img
# Set to "off" to switch a review step off
TRIAGE=
VERIFY=
TRACK_FIXES=
COMMANDS=
SESSION_DAYS=30
LOG_LEVEL=info
# Local-only sign-in shortcut for browser automation (ignored when NODE_ENV=production)
DEV_LOGIN=
